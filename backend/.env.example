# Copy this file to .env and change values as needed.
APP_NAME="LARP API"
DEBUG=true
DATABASE_URL=sqlite:///./larp.db

# Used by Part 5 (JWT auth). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
